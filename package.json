{
  "name": "lucashgrifoni-github-io",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node ./node_modules/astro/bin/astro.mjs dev",
    "build": "node ./node_modules/astro/bin/astro.mjs build",
    "preview": "node ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node ./node_modules/astro/bin/astro.mjs",
    "lighthouse:desktop": "npx --yes lighthouse http://127.0.0.1:4321/ --preset=desktop --only-categories=performance --view",
    "lighthouse:mobile": "npx --yes lighthouse http://127.0.0.1:4321/ --form-factor=mobile --only-categories=performance --view"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
