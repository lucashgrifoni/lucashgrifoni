---
import BaseLayout from '../layouts/BaseLayout.astro';
import SecurityStreamsBackground from '../components/effects/SecurityStreamsBackground.astro';
import FloatingTelemetry from '../components/effects/FloatingTelemetry.astro';
import Nav from '../components/layout/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import Experiences from '../components/sections/Experiences.astro';
import TechnicalCases from '../components/sections/TechnicalCases.astro';
import ProjectCard from '../components/sections/ProjectCard.astro';
import NowBuilding from '../components/sections/NowBuilding.astro';
import SkillGrid from '../components/sections/SkillGrid.astro';
import Footer from '../components/layout/Footer.astro';
import { projects } from '../data/projects';

const projectGroups = [
  { title: 'Released', items: projects.filter((p) => p.status === 'released') },
  { title: 'In active development', items: projects.filter((p) => p.status === 'development') },
].filter((g) => g.items.length > 0);
const privateProjects = projects.filter((p) => p.status === 'private');
---

<BaseLayout>
  <SecurityStreamsBackground />
  <FloatingTelemetry />
  <Nav />
  <main>
    <Hero />
    <Manifesto />
    <Experiences />
    <TechnicalCases />
    <section
      id="projects"
      class="relative z-10 overflow-hidden border-t border-[color-mix(in_srgb,var(--color-accent-2)_14%,var(--color-border))] bg-canvas py-24 md:py-32"
      aria-labelledby="projects-heading"
    >
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute left-1/2 top-0 h-[min(100vw,900px)] w-[min(140vw,1200px)] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-40"
          style="background: radial-gradient(ellipse at center, color-mix(in srgb, var(--color-accent-2) 18%, transparent) 0%, transparent 55%); filter: blur(64px);"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 h-80 w-80 rounded-full opacity-30 blur-3xl"
          style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 14%, transparent) 0%, transparent 70%);"
        >
        </div>
      </div>

      <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-14 md:mb-16" data-reveal>
          <p class="mono mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-[color:var(--color-accent-2)] md:text-xs">
            Open Source & Products
          </p>
          <h2
            id="projects-heading"
            class="font-display text-3xl font-bold tracking-[-0.02em] text-text-primary md:text-[2.35rem] md:leading-tight"
          >
            What I'm <span class="text-violet-gradient">Building</span>
          </h2>
          <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-text-muted md:text-base">
            Open source tools for AppSec and DevSecOps teams, each one born from a problem I kept meeting in real delivery pipelines.
          </p>
          <div
            class="mt-6 h-px w-20 bg-gradient-to-r from-[color:var(--color-accent-2)] to-transparent md:mt-8"
            aria-hidden="true"
          >
          </div>
        </div>

        <div class="flex flex-col gap-14 md:gap-16">
          {
            projectGroups.map((group) => (
              <div>
                <div class="mb-6 flex items-center gap-4" data-reveal>
                  <h3 class="mono text-[12px] font-semibold uppercase tracking-[0.22em] text-text-primary md:text-[13px]">
                    {group.title}
                  </h3>
                  <span class="mono rounded-full px-2.5 py-0.5 text-[11px] text-[color:var(--color-accent-2)] ring-1 ring-[color-mix(in_srgb,var(--color-accent-2)_40%,transparent)]">
                    {group.items.length}
                  </span>
                  <span class="h-px flex-1 bg-gradient-to-r from-[color-mix(in_srgb,var(--color-accent-2)_35%,transparent)] to-transparent" aria-hidden="true" />
                </div>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-7">
                  {group.items.map((project, index) => (
                    <div data-project-card style={`transition-delay: ${index * 0.08}s`}>
                      <ProjectCard project={project} />
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        {privateProjects.length > 0 && <NowBuilding projects={privateProjects} />}
      </div>
    </section>
    <SkillGrid />
    <Footer />
  </main>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const cards = document.querySelectorAll('[data-project-card]');
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
  );
  cards.forEach((el) => cardObserver.observe(el));

  const reveals = document.querySelectorAll('[data-reveal]');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
  );
  reveals.forEach((el) => revealObserver.observe(el));

  function initTilt() {
    if (reduceMotion) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll('[data-tilt-card]').forEach((card) => {
      const el = card;
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        el.style.setProperty('--rx', `${-y * 4.5}deg`);
        el.style.setProperty('--ry', `${x * 4.5}deg`);
      });
      el.addEventListener('mouseleave', () => {
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
      });
    });
  }
  initTilt();

  function initSpotlight() {
    if (reduceMotion) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    document.addEventListener('pointermove', (e) => {
      const el = e.target instanceof Element ? e.target.closest('[data-spotlight]') : null;
      if (!(el instanceof HTMLElement)) return;
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    }, { passive: true });
  }
  initSpotlight();
</script>
