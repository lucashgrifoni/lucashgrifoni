---
import { telemetryLines } from '../../data/telemetry';
import TelemetryGlyph from './TelemetryGlyph.astro';

const mobileMax = 6;

const rows = telemetryLines.map((line, i) => ({
  ...line,
  i,
  depth: 0.85 + (i % 4) * 0.04,
  blurPx: i % 3 === 0 ? 0.4 : 0,
}));
---

<div class="floating-telemetry" data-telemetry-layer aria-hidden="true">
  {
    rows.map((row) => (
      <div
        class:list={['ft-line', row.i >= mobileMax && 'ft-line--desktop-only']}
        data-depth={row.depth}
        style={{
          '--ft-blur': `${row.blurPx}px`,
        }}
      >
        <span class="ft-chip mono">
          <span class="ft-glyph">
            <TelemetryGlyph kind={row.glyph} />
          </span>
          <span class="ft-text">{row.text}</span>
        </span>
      </div>
    ))
  }
</div>

<script>
  // Each chip wanders: its heading drifts a little every frame and picks a new
  // target now and then, so paths curve at random instead of running in lanes.
  function initTelemetryWander() {
    const layer = document.querySelector<HTMLElement>('[data-telemetry-layer]');
    if (!layer) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    type Chip = { el: HTMLElement; x: number; y: number; angle: number; target: number; speed: number; scale: number; w: number; h: number };
    const chips: Chip[] = [];

    layer.querySelectorAll<HTMLElement>('.ft-line').forEach((el) => {
      if (el.offsetParent === null) return; // hidden on this screen size
      const scale = Number(el.dataset.depth ?? 1);
      const angle = Math.random() * Math.PI * 2;
      chips.push({
        el,
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        angle,
        target: angle,
        speed: (10 + Math.random() * 14) * scale,
        scale,
        w: el.offsetWidth,
        h: el.offsetHeight,
      });
    });

    let last = performance.now();
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      const W = window.innerWidth;
      const H = window.innerHeight;
      for (const c of chips) {
        if (Math.random() < dt * 0.35) c.target = c.angle + (Math.random() - 0.5) * Math.PI * 1.4;
        c.angle += (c.target - c.angle) * Math.min(1, dt * 0.8);
        c.x += Math.cos(c.angle) * c.speed * dt;
        c.y += Math.sin(c.angle) * c.speed * dt;
        if (c.x > W + 20) c.x = -c.w - 20;
        else if (c.x < -c.w - 20) c.x = W + 20;
        if (c.y > H + 20) c.y = -c.h - 20;
        else if (c.y < -c.h - 20) c.y = H + 20;
        c.el.style.transform = `translate3d(${c.x.toFixed(1)}px, ${c.y.toFixed(1)}px, 0) scale(${c.scale})`;
      }
      requestAnimationFrame(frame);
    }

    for (const c of chips) c.el.style.transform = `translate3d(${c.x}px, ${c.y}px, 0) scale(${c.scale})`;
    layer.setAttribute('data-ready', '');
    requestAnimationFrame(frame);
  }
  initTelemetryWander();
</script>

<style>
  .floating-telemetry {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-telemetry {
      display: none;
    }
  }

  /* Position comes from the wander script below; lines fade in once placed. */
  .ft-line {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    filter: blur(var(--ft-blur));
    transition: opacity 1.2s ease;
    will-change: transform;
  }

  .floating-telemetry[data-ready] .ft-line {
    opacity: 0.38;
  }

  @media (min-width: 768px) {
    .floating-telemetry[data-ready] .ft-line {
      opacity: 0.42;
    }
  }

  @media (max-width: 767px) {
    .ft-line--desktop-only {
      display: none;
    }
    .floating-telemetry[data-ready] .ft-line {
      opacity: 0.28;
    }
    .ft-chip {
      font-size: 9px !important;
      padding: 0.2rem 0.5rem !important;
    }
  }

  .ft-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-accent) 88%, var(--color-text));
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-accent) 6%, transparent),
      0 4px 24px color-mix(in srgb, var(--color-accent) 8%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @media (max-width: 767px) {
    .ft-chip {
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
  }

  .ft-glyph {
    display: flex;
    color: color-mix(in srgb, var(--color-accent) 95%, white);
    opacity: 0.95;
  }

  .ft-text {
    max-width: min(70vw, 420px);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 768px) {
    .ft-text {
      max-width: none;
    }
  }
</style>
