---
import { technicalCases } from '../../data/cases';

const steps = [
  { key: 'context', label: 'Context' },
  { key: 'approach', label: 'Approach' },
  { key: 'outcome', label: 'Outcome' },
] as const;
---

<section
  id="cases"
  class="relative z-10 border-t border-[color-mix(in_srgb,var(--color-accent)_8%,var(--color-border))] bg-canvas py-24 md:py-32"
  aria-labelledby="cases-heading"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 md:mb-16" data-reveal>
      <p
        class="mono mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent/95 md:text-xs"
      >
        Technical Cases
      </p>
      <h2
        id="cases-heading"
        class="max-w-[32rem] text-3xl font-bold tracking-[-0.02em] text-text-primary md:max-w-none md:text-[2.35rem] md:leading-tight"
      >
        How I Approach the Work
      </h2>
      <div
        class="mt-6 h-px w-16 bg-gradient-to-r from-accent/80 to-transparent md:mt-8"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-3 md:gap-7">
      {
        technicalCases.map((item, index) => (
          <article
            class="relative flex flex-col rounded-2xl border border-[color-mix(in_srgb,var(--color-accent)_12%,var(--color-border))] bg-gradient-to-b from-[color-mix(in_srgb,var(--color-surface)_95%,transparent)] to-surface p-7 shadow-float"
            data-reveal
            style={`transition-delay: ${index * 0.1}s`}
          >
            <p class="mono text-[11px] font-semibold text-accent/90">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 text-[1.2rem] font-bold leading-snug tracking-tight text-text-primary">
              {item.title}
            </h3>
            <dl class="mt-6 space-y-5">
              {
                steps.map((step) => (
                  <div>
                    <dt class="mono text-[10.5px] font-semibold uppercase tracking-[0.2em] text-accent/90">
                      {step.label}
                    </dt>
                    <dd class="mt-1.5 text-[14.5px] leading-[1.7] text-text-primary/90">
                      {item[step.key]}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </article>
        ))
      }
    </div>
  </div>
</section>
