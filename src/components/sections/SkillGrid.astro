---
import { stackCategories } from '../../data/stack';

const icons: Record<string, string> = {
  'security-tooling':
    '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z"/><circle cx="11.5" cy="11" r="2.6"/><path d="M13.4 12.9l2.1 2.1"/>',
  'cloud-platform': '<path d="M7 18h10a4 4 0 0 0 .6-8 6 6 0 0 0-11.5 1.6A3.3 3.3 0 0 0 7 18z"/><path d="M10 14h4"/>',
  'cicd-devsecops':
    '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.3 11l7.4-4"/><path d="M8.3 13l7.4 4"/>',
  'appsec-sdlc': '<path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/><path d="M13.5 5l-3 14"/>',
  governance: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9z"/><path d="M9 13l2 2 4-4"/>',
  engineering: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 10l3 2-3 2"/><path d="M12 15h5"/>',
};

const categories = stackCategories.map((cat, i) => {
  const parts = cat.title.split(' · ');
  const name = parts.length > 1 ? parts[parts.length - 1] : cat.title;
  const kicker = parts.length > 1 ? parts.slice(0, -1).join(' · ') : '';
  return { ...cat, name, kicker, tone: i % 2 === 0 ? 'teal' : 'violet' };
});

const total = stackCategories.reduce((n, c) => n + c.items.length, 0);
---

<section
  id="stack"
  class="stack-section relative z-10 overflow-hidden border-t border-[color-mix(in_srgb,var(--color-accent)_8%,var(--color-border))] bg-surface py-20 md:py-28 lg:py-32"
  aria-labelledby="stack-heading"
>
  <div
    class="pointer-events-none absolute -left-32 top-0 h-[min(80vw,520px)] w-[min(80vw,520px)] rounded-full opacity-30 blur-3xl"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent) 0%, transparent 62%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-24 bottom-0 h-[420px] w-[420px] rounded-full opacity-30 blur-3xl"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-2) 20%, transparent) 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="stack-head stack-animate" data-stack-animate style="--delay: 0s">
      <div>
        <p class="mono mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent/90 md:text-xs">Stack</p>
        <h2 id="stack-heading" class="font-display stack-h2">
          Capabilities across <span class="text-brand-gradient">AppSec & delivery</span>
        </h2>
      </div>
      <div>
        <p class="stack-intro">
          Technologies, platforms, and practices I have used to put security controls into real delivery pipelines.
        </p>
        <p class="stack-total mono">
          <span>{total}</span> technologies across <span>{stackCategories.length}</span> areas
        </p>
      </div>
    </header>

    <div class="stack-grid">
      {
        categories.map((cat, i) => (
          <div class="stack-animate" data-stack-animate style={`--delay: ${0.06 + i * 0.06}s`}>
            <article class="scard" data-tone={cat.tone} data-spotlight>
              <div class="scard-top">
                <span class="scard-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icons[cat.id] ?? icons['appsec-sdlc']} />
                </span>
                <span class="scard-count mono" aria-label={`${cat.items.length} items`}>
                  {String(cat.items.length).padStart(2, '0')}
                </span>
              </div>
              {cat.kicker && <p class="scard-kicker mono">{cat.kicker}</p>}
              <h3 class="scard-name font-display">{cat.name}</h3>
              <ul class="scard-chips">
                {cat.items.map((item) => (
                  <li class="mono">{item}</li>
                ))}
              </ul>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initStackSection() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('#stack [data-stack-animate]');
    if (reduce) {
      els.forEach((el) => el.classList.add('stack-animate--instant'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('stack-animate--inview');
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
  initStackSection();
</script>

<style>
  .stack-animate {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .stack-animate--inview,
  .stack-animate--instant {
    opacity: 1;
    transform: none;
  }

  .stack-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .stack-h2 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .stack-intro {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .stack-total {
    margin: 0.9rem 0 0;
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .stack-total span {
    color: var(--color-accent);
    font-weight: 600;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .stack-grid > div {
    min-width: 0;
  }

  .scard {
    --tone: var(--color-accent);
    --spot: var(--tone);
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--tone) 14%, var(--color-border));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 70%, var(--tone)) -40%,
      color-mix(in srgb, var(--color-bg) 85%, var(--color-surface)) 35%
    );
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
    transition:
      transform 320ms var(--ease-out-expo),
      border-color 320ms ease;
  }

  .scard[data-tone='violet'] {
    --tone: var(--color-accent-2);
  }

  .scard::before {
    content: '';
    position: absolute;
    inset: 0 1.5rem auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--tone), transparent);
    opacity: 0.8;
  }

  .scard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }

  .scard-icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.85rem;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 10%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--tone) 35%, transparent),
      0 0 26px color-mix(in srgb, var(--tone) 18%, transparent);
  }

  .scard-icon svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scard-count {
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1;
    color: color-mix(in srgb, var(--tone) 55%, var(--color-border));
    font-variant-numeric: tabular-nums;
  }

  .scard-kicker {
    margin: 0 0 0.3rem;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--tone);
  }

  .scard-name {
    margin: 0 0 1.1rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
  }

  .scard-chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .scard-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.65rem;
    border-radius: 999px;
    font-size: 11.5px;
    color: color-mix(in srgb, var(--color-text) 82%, var(--color-muted));
    background: color-mix(in srgb, var(--color-surface) 75%, transparent);
    border: 1px solid var(--color-border);
    transition:
      border-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  .scard-chips li::before {
    content: '';
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--tone);
    opacity: 0.85;
  }

  @media (hover: hover) and (pointer: fine) {
    .scard:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--tone) 45%, var(--color-border));
    }

    .scard-chips li:hover {
      color: var(--color-text);
      border-color: color-mix(in srgb, var(--tone) 70%, var(--color-border));
      box-shadow: 0 0 14px color-mix(in srgb, var(--tone) 25%, transparent);
    }
  }

  @media (max-width: 1024px) {
    .stack-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .stack-head,
    .stack-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .scard,
    .scard-chips li {
      transition: none;
    }
  }
</style>
