---
import { experiences } from '../../data/experiences';

// Bullets shown before "Show more"; the rest stay one click away.
const VISIBLE = 2;
---

<section
  id="experiences"
  class="exp-section relative z-10 overflow-hidden border-t border-[color-mix(in_srgb,var(--color-accent)_8%,var(--color-border))] bg-surface py-20 md:py-28"
  aria-labelledby="experiences-heading"
>
  <div
    class="pointer-events-none absolute -left-24 top-0 h-[min(75vw,480px)] w-[min(75vw,480px)] rounded-full opacity-25 blur-3xl"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 20%, transparent) 0%, transparent 65%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-24 bottom-0 h-80 w-80 rounded-full opacity-25 blur-3xl"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-2) 18%, transparent) 0%, transparent 72%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="exp-head exp-animate" data-exp-animate style="--delay: 0s">
      <div>
        <p class="mono mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent/90 md:text-xs">Experiences</p>
        <h2 id="experiences-heading" class="font-display exp-h2">
          Roles that shaped
          <span class="text-brand-gradient block">how I build AppSec & DevSecOps</span>
        </h2>
      </div>
      <p class="exp-intro">
        Organizations where I embedded security in delivery, from pipeline automation to governance and measurable risk
        reduction.
      </p>
    </header>

    <ol class="tl">
      {
        experiences.map((exp, i) => (
          <li class="tl-item exp-animate" data-exp-animate data-tone={i % 2 === 0 ? 'teal' : 'violet'} style={`--delay: ${0.04 + i * 0.05}s`}>
            <div class="tl-when mono">{exp.statusLabel}</div>
            <div class="tl-dot" aria-hidden="true" />
            <div class="tl-body">
              <h3 class="tl-company font-display">{exp.company}</h3>
              <p class="tl-role">{exp.role}</p>
              <p class="tl-meta mono">
                {exp.location} · {exp.arrangement}
              </p>
              <ul class="tl-points">
                {exp.paragraphs.slice(0, VISIBLE).map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              {exp.paragraphs.length > VISIBLE && (
                <details class="tl-more">
                  <summary>Show {exp.paragraphs.length - VISIBLE} more</summary>
                  <ul class="tl-points">
                    {exp.paragraphs.slice(VISIBLE).map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  function initExperiencesSection() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('#experiences [data-exp-animate]');
    if (reduce) {
      els.forEach((el) => el.classList.add('exp-animate--instant'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('exp-animate--inview');
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -7% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
  initExperiencesSection();
</script>

<style>
  .exp-animate {
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .exp-animate--inview,
  .exp-animate--instant {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .exp-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.25rem 3rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .exp-h2 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }

  .exp-intro {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* Timeline: date column, rail with dots, content column. */
  .tl {
    --when: 10.5rem;
    --rail: 2.25rem;
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: calc(var(--when) + var(--rail) / 2);
    width: 1px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-accent-2) 65%, transparent);
    opacity: 0.5;
  }

  .tl-item {
    --tone: var(--color-accent);
    display: grid;
    grid-template-columns: var(--when) var(--rail) minmax(0, 1fr);
    padding-bottom: 2.25rem;
  }

  .tl-item[data-tone='violet'] {
    --tone: var(--color-accent-2);
  }

  .tl-item:last-child {
    padding-bottom: 0;
  }

  .tl-when {
    padding-top: 0.3rem;
    text-align: right;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--tone);
    text-shadow: 0 0 14px color-mix(in srgb, var(--tone) 35%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .tl-dot {
    position: relative;
  }

  .tl-dot::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    left: 50%;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    border: 2px solid var(--tone);
    box-shadow: 0 0 12px color-mix(in srgb, var(--tone) 55%, transparent);
  }

  .tl-body {
    min-width: 0;
  }

  .tl-company {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .tl-role {
    margin: 0.15rem 0 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .tl-meta {
    margin: 0.3rem 0 0.85rem;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tl-points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: 72ch;
  }

  .tl-points li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 15px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-text) 88%, var(--color-muted));
  }

  .tl-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 2px;
    background: var(--tone);
  }

  .tl-more {
    margin-top: 0.65rem;
  }

  .tl-more .tl-points {
    margin-top: 0.5rem;
  }

  .tl-more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-accent-2);
  }

  .tl-more summary::-webkit-details-marker {
    display: none;
  }

  .tl-more summary::after {
    content: '+';
    font-size: 1rem;
    line-height: 1;
  }

  .tl-more[open] summary::after {
    content: '−';
  }

  .tl-more summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (max-width: 760px) {
    .exp-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .tl {
      --rail: 1.5rem;
    }

    .tl::before {
      left: calc(var(--rail) / 2);
    }

    .tl-item {
      grid-template-columns: var(--rail) minmax(0, 1fr);
    }

    .tl-when {
      grid-column: 2;
      grid-row: 1;
      padding: 0 0 0.2rem;
      text-align: left;
    }

    .tl-dot {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .tl-body {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
