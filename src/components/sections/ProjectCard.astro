---
import { statusLabels, type Project } from '../../data/projects';
import ProjectEmblem from './ProjectEmblem.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const isPrivate = project.status === 'private';
---

<article class="pcard" data-spotlight data-status={project.status}>
  <div class="pcard-top">
    <ProjectEmblem class="pcard-emblem" icon={project.icon} id={project.id} />
    <span class="pcard-status mono">{statusLabels[project.status]}</span>
  </div>

  <h3 class="pcard-title">{project.name}</h3>
  <p class="pcard-tagline">{project.tagline}</p>

  <ul class="pcard-highlights">
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>

  <ul class="pcard-stack" aria-label="Stack">
    {project.stack.map((s) => <li class="mono">{s}</li>)}
  </ul>

  <div class="pcard-actions">
    {
      project.links.map((link, i) => (
        <a
          class:list={['pcard-link', { 'pcard-link--main': i === 0 && !isPrivate }]}
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
    {isPrivate && <span class="pcard-note mono">Source code is private</span>}
  </div>
</article>

<style>
  .pcard {
    --spot: var(--color-accent-2);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 1.6rem;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-2) 14%, var(--color-border));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-surface) 92%, var(--color-accent-2)) 0%,
      var(--color-surface) 38%,
      color-mix(in srgb, var(--color-bg) 70%, var(--color-surface)) 100%
    );
    box-shadow: var(--shadow-float);
    transition:
      transform 320ms var(--ease-out-expo),
      border-color 320ms ease,
      box-shadow 320ms ease;
  }

  .pcard::before {
    content: '';
    position: absolute;
    inset: 0 1.25rem auto;
    height: 2px;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    opacity: 0.7;
  }

  .pcard[data-status='private'] {
    --spot: var(--color-muted);
    border-style: dashed;
  }

  .pcard[data-status='private']::before {
    background: linear-gradient(90deg, var(--color-muted), transparent);
    opacity: 0.45;
  }

  .pcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pcard :global(.pcard-emblem) {
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
    filter: drop-shadow(0 6px 18px color-mix(in srgb, var(--color-accent-2) 22%, transparent));
    transition: transform 420ms var(--ease-out-expo);
  }

  .pcard-status {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  [data-status='development'] .pcard-status {
    color: var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 12%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-2) 50%, transparent);
  }

  [data-status='private'] .pcard-status {
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-muted) 10%, transparent);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .pcard-title {
    margin: 0.35rem 0 0;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-text);
    text-wrap: balance;
    transition: color 260ms ease;
  }

  .pcard-tagline {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .pcard-highlights {
    margin: 0.2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .pcard-highlights li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 14.5px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-text) 90%, var(--color-muted));
  }

  .pcard-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 2px;
    background: var(--color-accent-2);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent-2) 60%, transparent);
  }

  .pcard-stack {
    margin: 0.3rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pcard-stack li {
    font-size: 11.5px;
    padding: 0.3rem 0.6rem;
    border-radius: 0.45rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 60%, transparent);
  }

  .pcard-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .pcard-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.6rem;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent-2);
    border: 1px solid color-mix(in srgb, var(--color-accent-2) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent-2) 6%, transparent);
    transition:
      background 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .pcard-link:hover {
    background: color-mix(in srgb, var(--color-accent-2) 16%, transparent);
    border-color: var(--color-accent-2);
    transform: translateY(-1px);
  }

  .pcard-link--main {
    color: var(--color-cta-on-accent);
    border-color: transparent;
    background: linear-gradient(100deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 40%, var(--color-accent-2)));
  }

  .pcard-link--main:hover {
    background: linear-gradient(100deg, var(--color-accent), var(--color-accent-2));
    border-color: transparent;
  }

  .pcard-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .pcard-note {
    font-size: 12px;
    color: var(--color-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .pcard:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--color-accent-2) 45%, var(--color-border));
      box-shadow:
        var(--shadow-lg),
        0 0 40px color-mix(in srgb, var(--color-accent-2) 12%, transparent);
    }

    .pcard:hover :global(.pcard-emblem) {
      transform: rotate(-4deg) scale(1.06);
    }

    .pcard:hover .pcard-title {
      color: color-mix(in srgb, var(--color-accent-2) 55%, var(--color-text));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard,
    .pcard :global(.pcard-emblem),
    .pcard-link {
      transition: none;
    }
  }
</style>
