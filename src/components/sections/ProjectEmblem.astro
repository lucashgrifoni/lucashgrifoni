---
import type { Project } from '../../data/projects';

interface Props {
  icon: Project['icon'];
  id: string;
  class?: string;
}

const { icon, id, class: className } = Astro.props;

// Glyphs for the project emblems (24x24 grid, stroked).
const glyphs: Record<Project['icon'], string> = {
  policy: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M9.5 14.5l2 2 4-4"/>',
  evidence: '<rect x="5" y="5" width="14" height="16" rx="2"/><path d="M9 3h6v4H9z"/><path d="M9 14l2 2 4-4"/>',
  key: '<circle cx="8" cy="15.5" r="4"/><path d="M11 12.5l8.5-8.5"/><path d="M16 7.5l3 3"/><path d="M13.5 10l2 2"/>',
  flask: '<path d="M9 3h6"/><path d="M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>',
  rules:
    '<path d="M8 4c-2 0-3 1-3 3v2c0 1.5-1 2.2-2 3 1 .8 2 1.5 2 3v2c0 2 1 3 3 3"/><path d="M16 4c2 0 3 1 3 3v2c0 1.5 1 2.2 2 3-1 .8-2 1.5-2 3v2c0 2-1 3-3 3"/><path d="M10.5 9.5h3M10.5 12h3M10.5 14.5h3"/>',
  agent:
    '<rect x="5" y="8" width="14" height="11" rx="2"/><path d="M12 5v3"/><circle cx="12" cy="4" r="1"/><circle cx="9.5" cy="13" r="1"/><circle cx="14.5" cy="13" r="1"/><path d="M9.5 16.5h5"/>',
  chart: '<path d="M4 20h16"/><path d="M7.5 20v-6"/><path d="M12 20V6"/><path d="M16.5 20v-9"/>',
  model: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5"/><path d="M12 12v9"/><path d="M12 12L4 7.5"/>',
  flag: '<path d="M5 21V4"/><path d="M5 5c2.5-1.6 4.5-1.6 7 0s4.5 1.6 7 0v8c-2.5 1.6-4.5 1.6-7 0s-4.5-1.6-7 0"/>',
};

const gid = `emblem-${id}`;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-accent)"></stop>
      <stop offset="1" style="stop-color: var(--color-accent-2)"></stop>
    </linearGradient>
  </defs>
  <rect x="1.5" y="1.5" width="61" height="61" rx="16" style="fill: var(--color-bg)" stroke={`url(#${gid})`} stroke-width="1.5"></rect>
  <rect x="1.5" y="1.5" width="61" height="61" rx="16" fill={`url(#${gid})`} opacity="0.08"></rect>
  <g
    transform="translate(14 14) scale(1.5)"
    fill="none"
    stroke={`url(#${gid})`}
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={glyphs[icon]}
  />
</svg>
