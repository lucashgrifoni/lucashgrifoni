---
const gateLines = [
  { check: 'SAST', detail: 'no critical findings' },
  { check: 'SCA', detail: 'reachable CVEs triaged' },
  { check: 'Secrets', detail: 'no live credentials' },
  { check: 'IaC', detail: 'policy checks passed' },
  { check: 'Evidence', detail: 'SBOM + SARIF bundled' },
];
---

<section class="hero relative z-10 overflow-hidden" aria-label="Introduction">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-40 left-[8%] h-[min(70vw,560px)] w-[min(80vw,640px)] rounded-full opacity-60"
      style="background: radial-gradient(ellipse at center, color-mix(in srgb, var(--color-accent) 20%, transparent) 0%, transparent 68%); filter: blur(56px);"
    >
    </div>
    <div
      class="absolute -right-24 top-24 h-[420px] w-[420px] rounded-full opacity-50"
      style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-2) 22%, transparent) 0%, transparent 70%); filter: blur(60px);"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(color-mix(in srgb, var(--color-accent) 40%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 40%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 70% at 40% 40%, black 20%, transparent 100%);"
    >
    </div>
  </div>

  <div class="hero-inner relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="mono animate-hero-label hero-eyebrow">Application Security · DevSecOps</p>
        <h1 class="font-display animate-hero-name hero-name">
          Lucas Henrique <span class="hero-name-accent">Grifoni</span>
        </h1>
        <p class="animate-hero-lead hero-lead">I embed security into software delivery, so teams ship faster with less risk.</p>
        <p class="animate-hero-tagline hero-sub">
          Six years building Application Security and DevSecOps programs across aviation, finance, telecom, and
          healthcare.
        </p>
        <div class="animate-hero-cta hero-ctas">
          <a class="btn-primary" href="#projects">See projects</a>
          <a
            class="btn-secondary"
            href="https://www.linkedin.com/in/lucas-henrique-grifoni/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a
          >
          <a class="hero-btn-ghost" href="https://github.com/lucashgrifoni" target="_blank" rel="noopener noreferrer"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>

      <div class="hero-term-wrap">
      <div class="hero-alerts" data-hero-alerts aria-hidden="true"></div>
      <div class="hero-term animate-hero-deco" role="img" aria-label="Illustration: a release gate running security checks before a release">
        <div class="hero-term-bar mono" aria-hidden="true">
          <i></i><i></i><i></i><span>release-gate.log</span>
        </div>
        <div class="hero-term-body mono" aria-hidden="true">
          <p class="hero-term-line" style="--i: 0"><span class="t-dim">$</span> release-gate --policy baseline</p>
          {
            gateLines.map((line, i) => (
              <p class="hero-term-line" style={`--i: ${i + 1}`}>
                <span class="t-ok">✓</span> <span class="t-check">{line.check}</span>
                <span class="t-dim">{line.detail}</span>
              </p>
            ))
          }
          <p class="hero-term-line t-vi" style={`--i: ${gateLines.length + 1}`}>
            → release approved<span class="hero-cursor"></span>
          </p>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Decorative scanner feed: a small alert card pops on the terminal every few seconds.
  const ALERTS = [
    { sev: 'critical', label: 'Critical', tool: 'SAST', msg: 'SQL injection in orders API' },
    { sev: 'high', label: 'High', tool: 'SCA', msg: 'Vulnerable dependency in build' },
    { sev: 'critical', label: 'Critical', tool: 'Secrets', msg: 'Hardcoded token in repository' },
    { sev: 'high', label: 'High', tool: 'DAST', msg: 'Reflected XSS on /search' },
    { sev: 'medium', label: 'Medium', tool: 'IaC', msg: 'Public storage bucket' },
    { sev: 'high', label: 'High', tool: 'Container', msg: 'Base image with known CVEs' },
  ];

  function initHeroAlerts() {
    const host = document.querySelector<HTMLElement>('[data-hero-alerts]');
    const term = document.querySelector<HTMLElement>('.hero-term');
    if (!host || !term) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let i = 0;
    const show = () => {
      if (document.hidden) return schedule();
      const a = ALERTS[i % ALERTS.length];
      i += 1;
      const card = document.createElement('div');
      card.className = `hero-alert hero-alert--${a.sev}`;
      card.innerHTML = `<span class="hero-alert-dot"></span><span class="hero-alert-sev mono">${a.label}</span><span class="hero-alert-tool mono">${a.tool}</span><span class="hero-alert-msg">${a.msg}</span>`;
      host.replaceChildren(card);
      term.dataset.alert = a.sev;
      window.setTimeout(() => card.classList.add('is-leaving'), 2600);
      window.setTimeout(() => {
        card.remove();
        delete term.dataset.alert;
      }, 3100);
      schedule();
    };
    const schedule = () => window.setTimeout(show, 3200 + Math.random() * 1800);
    window.setTimeout(show, 2800);
  }
  initHeroAlerts();
</script>

<style>
  .hero {
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
  }

  /* Soft backdrop so the floating telemetry stays behind the copy. */
  .hero-copy::before {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .hero-copy::before {
    inset: -3rem -4rem -3rem -5rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-bg) 92%, transparent) 55%, transparent 100%);
  }

  .hero-eyebrow {
    margin: 0 0 1rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-name {
    margin: 0 0 1.25rem;
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .hero-name-accent {
    display: inline-block;
    color: var(--color-accent);
    text-shadow: 0 0 42px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .hero-lead {
    margin: 0 0 0.75rem;
    max-width: 30ch;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.45;
    color: var(--color-text);
  }

  .hero-sub {
    margin: 0 0 2rem;
    max-width: 50ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8125rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero-btn-ghost:hover {
    border-color: color-mix(in srgb, var(--color-text) 40%, var(--color-border));
    transform: translateY(-1px);
  }

  .hero-term {
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    backdrop-filter: blur(10px);
    box-shadow:
      var(--shadow-lg),
      0 0 60px color-mix(in srgb, var(--color-accent-2) 10%, transparent);
    overflow: hidden;
  }

  .hero-term-wrap {
    position: relative;
    --sev-critical: #ff5d73;
    --sev-high: #ffb547;
    --sev-medium: var(--color-accent-2);
  }

  .hero-term {
    transition: box-shadow 400ms ease, border-color 400ms ease;
  }

  .hero-term[data-alert='critical'] {
    border-color: color-mix(in srgb, var(--sev-critical) 45%, var(--color-border));
    box-shadow: var(--shadow-lg), 0 0 46px color-mix(in srgb, var(--sev-critical) 18%, transparent);
  }

  .hero-term[data-alert='high'] {
    border-color: color-mix(in srgb, var(--sev-high) 40%, var(--color-border));
    box-shadow: var(--shadow-lg), 0 0 46px color-mix(in srgb, var(--sev-high) 14%, transparent);
  }

  .hero-term[data-alert='medium'] {
    border-color: color-mix(in srgb, var(--sev-medium) 45%, var(--color-border));
  }

  /* Alerts slide out below the terminal, in free space, so they never cover it. */
  .hero-alerts {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }

  .hero-alerts :global(.hero-alert) {
    --sev: var(--sev-high);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border-radius: 0.7rem;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-bg) 88%, var(--sev));
    border: 1px solid color-mix(in srgb, var(--sev) 55%, transparent);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 22px color-mix(in srgb, var(--sev) 22%, transparent);
    backdrop-filter: blur(8px);
    animation: alert-in 420ms var(--ease-out-expo) both;
  }

  .hero-alerts :global(.hero-alert--critical) {
    --sev: var(--sev-critical);
  }

  .hero-alerts :global(.hero-alert--medium) {
    --sev: var(--sev-medium);
  }

  .hero-alerts :global(.hero-alert.is-leaving) {
    animation: alert-out 480ms ease forwards;
  }

  .hero-alerts :global(.hero-alert-dot) {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sev);
    box-shadow: 0 0 10px var(--sev);
    animation: alert-blink 0.7s steps(1) infinite;
  }

  .hero-alerts :global(.hero-alert-sev) {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sev);
  }

  .hero-alerts :global(.hero-alert-tool) {
    font-size: 10.5px;
    padding: 0.1rem 0.4rem;
    border-radius: 0.35rem;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .hero-alerts :global(.hero-alert-msg) {
    overflow: hidden;
    text-overflow: ellipsis;
    color: color-mix(in srgb, var(--color-text) 85%, var(--color-muted));
  }

  @keyframes alert-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes alert-out {
    to {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes alert-blink {
    50% {
      opacity: 0.25;
    }
  }

  .hero-term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-muted);
  }

  .hero-term-bar i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-border);
  }

  .hero-term-bar span {
    margin-left: 0.4rem;
  }

  .hero-term-body {
    padding: 1.1rem 1.3rem 1.3rem;
    font-size: clamp(12px, 1.1vw, 13.5px);
    line-height: 2;
    overflow-x: auto;
  }

  .hero-term-line {
    margin: 0;
    white-space: pre;
    opacity: 0;
    transform: translateX(-6px);
    animation: term-line 420ms var(--ease-out-expo) forwards;
    animation-delay: calc(0.55s + var(--i) * 0.28s);
  }

  .t-ok {
    color: var(--color-accent);
  }

  .t-check {
    display: inline-block;
    min-width: 9ch;
    color: var(--color-text);
  }

  .t-dim {
    color: var(--color-muted);
  }

  .t-vi {
    color: var(--color-accent-2);
  }

  .hero-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    background: var(--color-accent-2);
    animation: cursor-blink 1.1s steps(1) infinite;
  }

  @keyframes term-line {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-term-line {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-cursor {
      animation: none;
    }
  }
</style>
