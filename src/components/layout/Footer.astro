---
const email = 'lucas.henriquegrifoni@gmail.com';
const year = new Date().getFullYear();
---

<footer
  id="contact"
  class="contact-footer relative z-10 overflow-hidden border-t border-[color-mix(in_srgb,var(--color-accent)_10%,var(--color-border))] bg-footer"
  aria-labelledby="contact-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -left-24 top-10 h-[420px] w-[420px] rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 18%, transparent) 0%, transparent 70%);"
    >
    </div>
    <div
      class="absolute -right-20 bottom-0 h-[460px] w-[460px] rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-2) 20%, transparent) 0%, transparent 70%);"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <div class="contact-panel contact-animate" data-contact-animate style="--delay: 0s">
      <div class="contact-copy">
        <p class="mono mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-accent/90 md:text-xs">Contact</p>
        <h2 id="contact-heading" class="font-display contact-h2">
          Let's talk about <span class="text-brand-gradient">your pipeline</span>
        </h2>
        <p class="contact-lead">
          Questions about a project, a role, or how to bring security into your delivery? Reach out on any of these.
        </p>
      </div>

      <ul class="contact-list">
        <li>
          <a class="crow" href="https://www.linkedin.com/in/lucas-henrique-grifoni/" target="_blank" rel="noopener noreferrer" data-spotlight>
            <span class="crow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"
                ></path>
              </svg>
            </span>
            <span class="crow-text">
              <span class="crow-label mono">LinkedIn</span>
              <span class="crow-value">/in/lucas-henrique-grifoni</span>
            </span>
            <span class="crow-cta">Open profile <span aria-hidden="true">↗</span></span>
          </a>
        </li>
        <li>
          <a class="crow" href="https://github.com/lucashgrifoni" target="_blank" rel="noopener noreferrer" data-spotlight>
            <span class="crow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path>
              </svg>
            </span>
            <span class="crow-text">
              <span class="crow-label mono">GitHub</span>
              <span class="crow-value">@lucashgrifoni</span>
            </span>
            <span class="crow-cta">View repositories <span aria-hidden="true">↗</span></span>
          </a>
        </li>
        <li>
          <div class="crow" data-spotlight>
            <span class="crow-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>
            <span class="crow-text">
              <span class="crow-label mono">Email</span>
              <span class="crow-value" id="contact-email">{email}</span>
            </span>
            <span class="crow-actions">
              <button type="button" class="crow-btn" id="contact-copy">Copy</button>
              <a class="crow-btn crow-btn--ghost" href={`mailto:${email}`}>Write</a>
            </span>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div class="contact-bar relative">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-6 sm:px-6 lg:px-8">
      <p class="m-0">© {year} Lucas Henrique Grifoni · Built with focus on security, automation, and impact.</p>
      <a href="#" class="contact-top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<script>
  function initContactSection() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('#contact [data-contact-animate]');
    if (reduce) {
      els.forEach((el) => el.classList.add('contact-animate--instant'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('contact-animate--inview');
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      els.forEach((el) => io.observe(el));
    }

    const btn = document.getElementById('contact-copy');
    const value = document.getElementById('contact-email');
    if (!btn || !value) return;
    btn.addEventListener('click', () => {
      const text = value.textContent?.trim() ?? '';
      const done = (label: string) => {
        btn.textContent = label;
        window.setTimeout(() => (btn.textContent = 'Copy'), 1800);
      };
      const select = () => {
        const range = document.createRange();
        range.selectNodeContents(value);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(
          () => done('Copied'),
          () => {
            select();
            done('Press Ctrl+C');
          },
        );
      } else {
        select();
        done('Press Ctrl+C');
      }
    });
  }
  initContactSection();
</script>

<style>
  .contact-animate {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }

  .contact-animate--inview,
  .contact-animate--instant {
    opacity: 1;
    transform: none;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .contact-h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .contact-lead {
    margin: 1.25rem 0 0;
    max-width: 42ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .contact-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .crow {
    --spot: var(--color-accent-2);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-2) 14%, var(--color-border));
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-text);
    transition:
      transform 300ms var(--ease-out-expo),
      border-color 300ms ease;
  }

  a.crow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .crow-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.85rem;
    color: var(--color-accent);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent) 16%, transparent),
      color-mix(in srgb, var(--color-accent-2) 16%, transparent)
    );
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .crow-icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .crow-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .crow-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .crow-value {
    font-size: 15.5px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .crow-cta {
    flex: none;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-accent-2);
    white-space: nowrap;
  }

  .crow-actions {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }

  .crow-btn {
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: 0.55rem;
    cursor: pointer;
    border: 0;
    color: var(--color-cta-on-accent);
    background: linear-gradient(100deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 45%, var(--color-accent-2)));
  }

  .crow-btn--ghost {
    color: var(--color-accent-2);
    background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent-2) 50%, var(--color-border));
  }

  .crow-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact-bar {
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-muted);
  }

  .contact-top {
    font-weight: 600;
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .crow:hover {
      transform: translateX(4px);
      border-color: color-mix(in srgb, var(--color-accent-2) 45%, var(--color-border));
    }
  }

  @media (max-width: 860px) {
    .contact-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .crow {
      flex-wrap: wrap;
    }

    .crow-cta,
    .crow-actions {
      margin-left: 3.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .crow {
      transition: none;
    }
  }
</style>
